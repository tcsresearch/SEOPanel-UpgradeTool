function CopyCustomFiles() {
	CopyCustomPlugins
	CopyCustomThemes
	CopyCustomUploads
}

function CopyCustomPlugins() {
# Copy custom plugins
	echo "Copying custom plugins..."
	cp -Rv seopanel_old_*/plugins/custom_* seopanel/plugins/
}

function CopyCustomThemes() {
# Copy custom themes (if any)
	echo "Copying custom themes (if they exist)..."
	cp -Rv seopanel_old_*/themes/custom_* seopanel/themes/
}

function CopyCustomUploads() {
# Copy any custom uploads or data
	echo "Copying custom uploads..."
	cp -Rv seopanel_old_*/uploads/* seopanel/uploads/
}
