function CopyConfig() {
	if [ -f seopanel_old_*/config/sp-config.php ]; then
		CopyOldConfig
	else
		CopyConfigFromSample
fi

function CopyOldConfig() {
# Copy your old config to new installation
	echo "Found old config.  Copying..."
	cp -v seopanel_old_*/config/sp-config.php seopanel/config/
}

function CopyConfigFromSample() {
# If that file doesn't exist, copy from sample
	echo "Old config NOT found!  Copying from sample..."
	cp -v seopanel/config/sp-config-sample.php seopanel/config/sp-config.php
}
